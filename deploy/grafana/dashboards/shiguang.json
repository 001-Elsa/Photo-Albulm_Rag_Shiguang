{
  "title": "Shiguang Enterprise",
  "uid": "shiguang-enterprise",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "API Request Rate",
      "targets": [{"expr": "sum(rate(shiguang_http_requests_total[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Search P95",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(shiguang_search_duration_seconds_bucket[5m])) by (le))"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Queue Depth",
      "targets": [{"expr": "shiguang_job_queue_depth"}],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8}
    }
  ]
}
