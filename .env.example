# 非敏感容器参数。真实密钥放在 deploy/secrets/*.txt（已被 .gitignore 排除）。
SHIGUANG_POSTGRES_ADMIN_PASSWORD_FILE=./deploy/secrets/postgres_admin_password.txt
SHIGUANG_POSTGRES_APP_PASSWORD_FILE=./deploy/secrets/postgres_app_password.txt
SHIGUANG_MINIO_ACCESS_KEY=shiguang
SHIGUANG_BOOTSTRAP_ADMIN_USERNAME=admin
SHIGUANG_BOOTSTRAP_ORGANIZATION_NAME=Shiguang
