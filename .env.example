SHIGUANG_COOKIE_SECURE=false
SHIGUANG_EMBED_BACKEND=demo
SHIGUANG_EMBEDDING_DIMENSION=512
SHIGUANG_ENABLE_OCR=false
SHIGUANG_ENABLE_FACES=false
